{
  "manifest_version": 3,
  "name": "KDP Niches Saver",
  "version": "1.0.0",
  "description": "Save Amazon book, author, and search results pages directly to the local Niches board.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://amazon.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.es/*",
    "https://*.amazon.fr/*",
    "https://*.amazon.it/*",
    "https://*.media-amazon.com/*",
    "https://*.ssl-images-amazon.com/*"
  ],
  "action": {
    "default_title": "Save to Niches",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kdp-niches-saver@local"
    }
  }
}
